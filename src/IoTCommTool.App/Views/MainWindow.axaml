<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IoTCommTool.App.ViewModels"
        xmlns:views="using:IoTCommTool.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="IoTCommTool.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="IoTCommTool · 多协议通信调试"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource IotBackground}">
    <Grid RowDefinitions="64,*">
        <Border Grid.Row="0"
                Background="{DynamicResource IotCardBg}"
                BorderBrush="{DynamicResource IotBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="36" Height="36"
                            CornerRadius="10"
                            Background="{DynamicResource IotAccentBrush}">
                        <TextBlock Text="IO"
                                   Foreground="{DynamicResource IotOnAccentBrush}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="IoTCommTool"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Classes="caption" Text="多协议通信调试工具" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <ComboBox Width="184"
                              ItemsSource="{Binding Protocols}"
                              SelectedItem="{Binding SelectedProtocol, Mode=TwoWay}"
                              PlaceholderText="选择协议类型">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProtocolItem">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Classes="primary"
                            Command="{Binding NewConnectionCommand}"
                            ToolTip.Tip="新建连接（Ctrl+N）">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="+" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="新建连接" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ThemeButton"
                            Classes="icon ghost"
                            AutomationProperties.Name="切换主题"
                            ToolTip.Tip="{Binding ThemeToolTip}">
                        <Button.Flyout>
                            <MenuFlyout x:CompileBindings="False">
                                <MenuItem Header="跟随系统"
                                          ToggleType="Radio"
                                          GroupName="Theme"
                                          IsChecked="{Binding IsThemeSystem}"
                                          Command="{Binding SetThemeCommand}"
                                          CommandParameter="跟随系统" />
                                <MenuItem Header="浅色"
                                          ToggleType="Radio"
                                          GroupName="Theme"
                                          IsChecked="{Binding IsThemeLight}"
                                          Command="{Binding SetThemeCommand}"
                                          CommandParameter="浅色" />
                                <MenuItem Header="深色"
                                          ToggleType="Radio"
                                          GroupName="Theme"
                                          IsChecked="{Binding IsThemeDark}"
                                          Command="{Binding SetThemeCommand}"
                                          CommandParameter="深色" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <Grid Width="18" Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Path IsVisible="{Binding IsThemeSystem}"
                                  Data="M2,3 H16 V12 H2 Z M7,15 H11 M9,12 V15"
                                  Stretch="None"
                                  Fill="Transparent"
                                  Stroke="{DynamicResource IotTextPrimary}"
                                  StrokeThickness="1.4" />
                            <Grid IsVisible="{Binding IsThemeLight}">
                                <Ellipse Width="6" Height="6"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource IotTextPrimary}" />
                                <Path Data="M9,0 V2 M9,16 V18 M0,9 H2 M16,9 H18 M2.7,2.7 L4.1,4.1 M13.9,13.9 L15.3,15.3 M2.7,15.3 L4.1,13.9 M13.9,4.1 L15.3,2.7"
                                      Stretch="None"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource IotTextPrimary}"
                                      StrokeThickness="1.2" />
                            </Grid>
                            <Path IsVisible="{Binding IsThemeDark}"
                                  Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource IotTextPrimary}" />
                        </Grid>
                    </Button>

                    <Border Width="1" Height="24"
                            Background="{DynamicResource IotBorderBrush}"
                            Margin="4,0" />

                    <Button Classes="ghost"
                            Command="{Binding ToggleHistorySidebarCommand}"
                            ToolTip.Tip="连接历史（Ctrl+F）">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="icon"
                                  Width="14" Height="14"
                                  Fill="{DynamicResource IotTextPrimary}"
                                  Data="M2,4 H16 V6 H2 Z M2,9 H16 V11 H2 Z M2,14 H12 V16 H2 Z" />
                            <TextBlock Text="历史" VerticalAlignment="Center" />
                            <Border Classes="chip"
                                    Padding="6,1"
                                    IsVisible="{Binding HasSavedConfigs}"
                                    VerticalAlignment="Center">
                                <TextBlock Classes="chipText" Text="{Binding AllSavedConfigs.Count}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <views:HistorySidebar x:Name="HistoryPanel"
                                  Width="260"
                                  Grid.Column="0"
                                  IsVisible="{Binding HistorySidebarVisible}" />

            <Grid Grid.Column="1">
                <TabControl x:Name="TabsControl"
                            ItemsSource="{Binding Tabs}"
                            SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                            IsVisible="{Binding HasTabs}"
                            Margin="16,12,16,16">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConnectionViewModelBase">
                            <StackPanel Orientation="Horizontal" Spacing="7" Margin="2,0">
                                <Ellipse Classes="statusDot"
                                         Fill="{Binding StatusBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           MaxWidth="180"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Title}" />
                                <Button Classes="tabMore"
                                        Content="⋯"
                                        Click="OnTabMenuClick"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="标签操作" />
                                <Button Classes="tabClose"
                                        Content="×"
                                        Command="{Binding CloseRequestCommand}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="关闭连接" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate x:CompileBindings="False">
                            <ContentControl Content="{Binding}" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <ScrollViewer IsVisible="{Binding !HasTabs}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="900"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="18"
                                Margin="20">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="连接设备，开始调试"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Classes="caption"
                                       Text="支持 TCP、UDP、Modbus 与 Siemens S7，多连接并行调试。"
                                       FontSize="13"
                                       TextAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Protocols}"
                                      MaxWidth="800"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <Button Classes="protocolCard"
                                            Width="184"
                                            Height="124"
                                            Margin="6"
                                            Command="{Binding DataContext.QuickStartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding Description}">
                                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Border Width="28" Height="28"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource IotAccentSubtleBrush}">
                                                    <TextBlock Text="{Binding ShortCode}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource IotAccentBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Group}"
                                                           Classes="caption"
                                                           FontSize="10"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Margin="0,8,0,0" />
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding Description}"
                                                       Classes="caption"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Height="32" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    HorizontalAlignment="Center">
                            <Button Classes="ghost"
                                    Content="打开连接历史"
                                    Command="{Binding ToggleHistorySidebarCommand}"
                                    IsVisible="{Binding !HistorySidebarVisible}" />
                            <TextBlock Classes="caption"
                                       Text="连接成功后自动保存配置"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
