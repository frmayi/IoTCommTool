<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IoTCommTool.App.ViewModels"
        x:Class="IoTCommTool.App.Views.AsciiReferenceDialog"
        x:DataType="vm:AsciiReferenceViewModel"
        Title="ASCII 参考表"
        Width="480"
        Height="600"
        MinWidth="400"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource IotBackground}">
    <Border Classes="card" Margin="16">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
            <StackPanel Spacing="2">
                <TextBlock Classes="cardTitle" Text="ASCII 参考表" />
                <TextBlock Classes="caption" Text="标准 ASCII（0–127）；双击某行复制 \xNN 转义。" />
            </StackPanel>

            <TextBox Grid.Row="1"
                     Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="搜索十进制 / Hex / 字符 / 说明" />

            <Grid Grid.Row="2" ColumnDefinitions="64,64,88,*" Margin="8,0">
                <TextBlock Classes="caption" Text="十进制" />
                <TextBlock Grid.Column="1" Classes="caption" Text="Hex" />
                <TextBlock Grid.Column="2" Classes="caption" Text="字符" />
                <TextBlock Grid.Column="3" Classes="caption" Text="说明" />
            </Grid>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AsciiEntry">
                            <Border Padding="8,5"
                                    Cursor="Hand"
                                    DoubleTapped="OnRowDoubleTapped"
                                    ToolTip.Tip="{Binding Escape, StringFormat='双击复制 {0}'}">
                                <Grid ColumnDefinitions="64,64,88,*">
                                    <TextBlock Text="{Binding Dec}"
                                               FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Hex}"
                                               FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Char}"
                                               FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3"
                                               Classes="caption"
                                               Text="{Binding Description}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
