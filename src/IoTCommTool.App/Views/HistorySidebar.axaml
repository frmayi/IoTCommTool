<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IoTCommTool.App.ViewModels"
             x:Class="IoTCommTool.App.Views.HistorySidebar"
             x:DataType="vm:MainWindowViewModel">
    <Border Classes="sidebar">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,16,12,10">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="cardTitle" Text="连接历史" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="caption" Text="{Binding HistoryCountText}" VerticalAlignment="Center" />
                        <Button Classes="link"
                                Content="清除筛选"
                                Command="{Binding ClearHistoryFiltersCommand}"
                                IsVisible="{Binding HasActiveHistoryFilter}"
                                ToolTip.Tip="清除搜索与协议筛选" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="icon ghost"
                        Command="{Binding ToggleHistorySidebarCommand}"
                        ToolTip.Tip="收起历史侧栏">
                    <TextBlock Text="‹" FontSize="20" VerticalAlignment="Center" />
                </Button>
            </Grid>

            <TextBox x:Name="HistorySearchBox"
                     Grid.Row="1"
                     Margin="16,0,16,8"
                     Text="{Binding HistorySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="搜索名称、协议或地址"
                     KeyDown="OnSearchKeyDown" />

            <ComboBox Grid.Row="2"
                      Margin="16,0,16,10"
                      ItemsSource="{Binding HistoryGroups}"
                      SelectedItem="{Binding SelectedHistoryGroup, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" />

            <Grid Grid.Row="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SavedConfigs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SavedConfigItem">
                                <Grid ColumnDefinitions="*,Auto" Margin="8,2">
                                    <Button Classes="historyOpen"
                                            Command="{Binding OpenCommand}"
                                            ToolTip.Tip="打开此连接">
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              RowDefinitions="Auto,Auto"
                                              ColumnSpacing="8"
                                              RowSpacing="2">
                                            <Border Grid.RowSpan="2"
                                                    Width="32"
                                                    Height="32"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource IotAccentSubtleBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProtocolCode}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource IotAccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding DisplayName}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding LastUsedRelativeText}"
                                                       Classes="caption"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Grid.ColumnSpan="2"
                                                       Text="{Binding EndpointSummary}"
                                                       Classes="caption"
                                                       FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding EndpointSummary}" />
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Classes="historyDelete"
                                            Content="×"
                                            Command="{Binding DeleteCommand}"
                                            ToolTip.Tip="删除连接历史"
                                            VerticalAlignment="Center"
                                            Margin="2,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel IsVisible="{Binding ShowNoHistory}"
                            Spacing="6"
                            Margin="20,28,20,0"
                            HorizontalAlignment="Center">
                    <TextBlock Text="还没有连接历史"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Classes="caption"
                               Text="连接成功后会自动记录在这里"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel IsVisible="{Binding ShowNoMatches}"
                            Spacing="8"
                            Margin="20,28,20,0"
                            HorizontalAlignment="Center">
                    <TextBlock Text="没有匹配的记录"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <Button Classes="ghost small"
                            Content="清除筛选"
                            Command="{Binding ClearHistoryFiltersCommand}"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4" Margin="16,8,16,12">
                <TextBlock Classes="caption"
                           Text="连接成功后自动记录"
                           IsVisible="{Binding !IsUndoVisible}"
                           TextWrapping="Wrap" />
                <Border Classes="inset"
                        Padding="10,8"
                        IsVisible="{Binding IsUndoVisible}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="已删除连接记录"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1"
                                Classes="ghost small"
                                Content="撤销"
                                Command="{Binding UndoDeleteCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
