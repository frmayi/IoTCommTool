<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IoTCommTool.App.ViewModels"
             xmlns:views="using:IoTCommTool.App.Views"
             x:Class="IoTCommTool.App.Views.ModbusRtuMasterView"
             x:DataType="vm:ModbusRtuMasterViewModel">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="card" Margin="0,0,0,12">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="cardTitle" Text="Modbus RTU 主站" />
                        <TextBlock Classes="caption" Text="通过串口读取或写入 Modbus RTU 从站" />
                    </StackPanel>
                    <views:ConnectionActions Grid.Column="1" />
                </Grid>

                <Border IsEnabled="{Binding IsFormEnabled}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
                            <StackPanel Classes="field">
                                <TextBlock Classes="fieldLabel" Text="名称" />
                                <TextBox Text="{Binding Title, Mode=TwoWay}" PlaceholderText="连接名称" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Classes="fieldHint"
                                       Text="串口参数在下方设置"
                                       VerticalAlignment="Bottom" />
                        </Grid>
                        <views:SerialSettingsPanel DataContext="{Binding Serial}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="380" MaxWidth="520" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <views:MasterOperationPanel />
            </ScrollViewer>
            <GridSplitter Grid.Column="1" Classes="splitter" />
            <views:LogPanel Grid.Column="2" />
        </Grid>
    </Grid>
</UserControl>
