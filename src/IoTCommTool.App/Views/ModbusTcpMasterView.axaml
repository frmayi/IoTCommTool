<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IoTCommTool.App.ViewModels"
             xmlns:views="using:IoTCommTool.App.Views"
             x:Class="IoTCommTool.App.Views.ModbusTcpMasterView"
             x:DataType="vm:ModbusTcpMasterViewModel">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="card" Margin="0,0,0,12">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="cardTitle" Text="Modbus TCP 主站" />
                        <TextBlock Classes="caption" Text="读取或写入远程 Modbus TCP 从站" />
                    </StackPanel>
                    <views:ConnectionActions Grid.Column="1" />
                </Grid>
                <Grid ColumnDefinitions="2*,3*,*" ColumnSpacing="12"
                      IsEnabled="{Binding IsFormEnabled}">
                    <StackPanel Classes="field">
                        <TextBlock Classes="fieldLabel" Text="名称" />
                        <TextBox Text="{Binding Title, Mode=TwoWay}" PlaceholderText="连接名称" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Classes="field">
                        <TextBlock Classes="fieldLabel" Text="主机" />
                        <TextBox Text="{Binding Host, Mode=TwoWay}" PlaceholderText="127.0.0.1" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Classes="field">
                        <TextBlock Classes="fieldLabel" Text="端口" />
                        <TextBox Text="{Binding Port, Mode=TwoWay}" PlaceholderText="502" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="380" MaxWidth="520" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <views:MasterOperationPanel />
            </ScrollViewer>
            <GridSplitter Grid.Column="1" Classes="splitter" />
            <views:LogPanel Grid.Column="2" />
        </Grid>
    </Grid>
</UserControl>
