<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IoTCommTool.App.ViewModels"
             xmlns:views="using:IoTCommTool.App.Views"
             xmlns:models="using:IoTCommTool.App.Models"
             x:Class="IoTCommTool.App.Views.TcpClientView"
             x:DataType="vm:TcpClientViewModel">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="card" Margin="0,0,0,12">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="cardTitle" Text="TCP 客户端" />
                        <TextBlock Classes="caption" Text="主动连接远程 TCP 服务端" />
                    </StackPanel>
                    <views:ConnectionActions Grid.Column="1" />
                </Grid>

                <Grid ColumnDefinitions="2*,3*,*" RowDefinitions="Auto,Auto"
                      ColumnSpacing="12" RowSpacing="10"
                      IsEnabled="{Binding IsFormEnabled}">
                    <StackPanel Classes="field">
                        <TextBlock Classes="fieldLabel" Text="名称" />
                        <TextBox Text="{Binding Title, Mode=TwoWay}" PlaceholderText="连接名称" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Classes="field">
                        <TextBlock Classes="fieldLabel" Text="主机" />
                        <TextBox Text="{Binding Host, Mode=TwoWay}" PlaceholderText="127.0.0.1" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Classes="field">
                        <TextBlock Classes="fieldLabel" Text="端口" />
                        <TextBox Text="{Binding Port, Mode=TwoWay}" PlaceholderText="502" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Classes="field">
                        <TextBlock Classes="fieldLabel" Text="本地出口 IP（可选）" />
                        <ComboBox ItemsSource="{Binding LocalBindChoices}"
                                  SelectedItem="{Binding SelectedLocalBind, Mode=TwoWay}"
                                  ToolTip.Tip="自动按系统路由；双网卡时可指定从有线或无线网卡发起">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:LocalAddressOption">
                                    <TextBlock Text="{Binding Display}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Classes="fieldHint"
                               Text="双网卡时指定出口；自动按系统路由"
                               VerticalAlignment="Bottom" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="380" MaxWidth="520" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>
            <views:SendPanel Grid.Column="0" />
            <GridSplitter Grid.Column="1" Classes="splitter" />
            <views:LogPanel Grid.Column="2" />
        </Grid>
    </Grid>
</UserControl>
