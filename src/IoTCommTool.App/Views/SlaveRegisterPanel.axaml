<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IoTCommTool.App.ViewModels"
             x:Class="IoTCommTool.App.Views.SlaveRegisterPanel"
             x:DataType="vm:ModbusSlaveViewModelBase">
    <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock Classes="cardTitle" Text="寄存器查看 / 编辑" />
                <TextBlock Classes="caption" Text="刷新后可编辑值，再点击写入" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <StackPanel Classes="field">
                    <TextBlock Classes="fieldLabel" Text="寄存器区" />
                    <ComboBox ItemsSource="{Binding Areas}"
                              SelectedIndex="{Binding AreaIndex, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="field">
                    <TextBlock Classes="fieldLabel" Text="起始地址" />
                    <TextBox Text="{Binding StartAddress, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Classes="field">
                    <TextBlock Classes="fieldLabel" Text="数量（≤100）" />
                    <TextBox Text="{Binding Count, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Classes="fieldHint"
                           Text="至少保留一个寄存器；数值按十进制显示。"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="ghost"
                            Content="刷新"
                            Command="{Binding RefreshRegistersCommand}"
                            IsEnabled="{Binding IsConnected}" />
                    <Button Classes="primary"
                            Content="写入"
                            Command="{Binding WriteRegistersCommand}"
                            IsEnabled="{Binding IsConnected}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" Classes="inset" Padding="8">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="78,*" Margin="2,0">
                        <TextBlock Classes="caption" FontWeight="SemiBold" Text="地址" />
                        <TextBlock Grid.Column="1" Classes="caption" FontWeight="SemiBold" Text="值" />
                    </Grid>
                    <Border Grid.Row="1" Classes="divider" Margin="0,6,0,4" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RegisterRow">
                                    <Grid ColumnDefinitions="78,*" Margin="0,2">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Address}"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                                                   FontSize="12" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Value, Mode=TwoWay}"
                                                 FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                                                 FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
